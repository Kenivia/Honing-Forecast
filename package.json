{
  "name": "honing-forecast",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run wasm && vite --port 5173 --strictPort",
    "wasm": "wasm-pack build crates/wasm --release --target web",
    "browse": "node scanner_setup/browser/browse.mjs",
    "scanner-profile": "node scanner_setup/browser/profile_scanner.mjs",
    "scanner-compare": "node scanner_setup/browser/scan_compare.mjs",
    "scanner-suite": "python scanner_setup/scanner/suite.py",
    "perf": "node scripts/perf/bench.mjs",
    "guide-shots": "node scripts/guide_shots/shoot.mjs",
    "test": "pnpm run test:rust && pnpm run test:node && pnpm run test:unit && pnpm run test:e2e",
    "test:rust": "cargo test -p hf-core -p hf-arena && cargo test -p hf-scanner --lib",
    "test:node": "node tests/run.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:staging": "playwright test --config playwright.staging.config.ts",
    "browsers": "playwright install chromium firefox && playwright-mcp install-browser firefox",
    "arena": "cargo run --release -q -p hf-arena --",
    "lab": "node scripts/lab/lab.mjs",
    "change-log": "python ./scripts/change_log_helper/build.py",
    "check": "vue-tsc --noEmit",
    "no-test-build": "pnpm run wasm && vite build",
    "staging-build": "pnpm run wasm && vite build --mode staging",
    "build": "pnpm run test && pnpm run no-test-build",
    "updates": "rustup update && cargo install wasm-pack --force && cargo update && pnpm update",
    "no-check-deploy": "git push origin main:Production --force-with-lease",
    "deploy": "pwsh -File ./scripts/pre_deploy_check.ps1 && pnpm run no-check-deploy",
    "cloudflare-deploy": "wrangler deploy --config cloudflare/wrangler.toml",
    "cloudflare-dev": "wrangler dev --remote --config cloudflare/wrangler.toml",
    "pull-analytics": "node scripts/pull-analytics.mjs",
    "analytics": "pnpm run pull-analytics && python -m streamlit run scripts/analytics/app.py",
    "market": "python -m streamlit run scripts/market/app.py",
    "market-scan": "cargo run --release -q -p hf-market --bin market_scan -- --only materials,gems,exchange --gap 0",
    "remove-tmp": "node -e \"require('fs').rmSync('.tmp', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@floating-ui/vue": "2.0.1",
    "@msgpack/msgpack": "^3.1.3",
    "@sindresorhus/transliterate": "^3.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/dom-webcodecs": "^0.1.19",
    "@vueuse/core": "^14.4.0",
    "brotli-dec-wasm": "^2.3.2",
    "chart.js": "4.5.1",
    "chartjs-chart-matrix": "3.1.0",
    "chartjs-plugin-annotation": "3.1.0",
    "fast-deep-equal": "^3.1.3",
    "harfbuzzjs": "^1.6.4",
    "lz-string": "^1.5.0",
    "marked": "^18.2.0",
    "nouislider": "^15.8.1",
    "oauth4webapi": "^3.8.8",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/mcp": "^0.0.83",
    "@playwright/test": "^1.65.1",
    "@types/dom-mediacapture-transform": "^0.1.12",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/test-utils": "2.5.1",
    "concurrently": "^10.0.7",
    "devalue": "^6.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pure-rand": "^8.4.2",
    "source-map-js": "1.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "5.0.5",
    "vue-tsc": "^2.2.12",
    "wrangler": "^4.162.0"
  }
}
