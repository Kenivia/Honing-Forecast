{
  "name": "honing-forecast",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run wasm && vite",
    "wasm": "wasm-pack build crates/wasm --release --target web",
    "browse": "node scanner_setup/browser/browse.mjs",
    "scanner-profile": "node scanner_setup/browser/profile_scanner.mjs",
    "scanner-compare": "node scanner_setup/browser/scan_compare.mjs",
    "scanner-suite": "python scanner_setup/scanner/suite.py",
    "test": "pnpm run test:rust && pnpm run test:node && pnpm run test:unit && pnpm run test:e2e",
    "test:rust": "cargo test -p hf-core -p hf-arena",
    "test:node": "node tests/run.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "browsers": "playwright install chromium firefox && playwright-mcp install-browser firefox",
    "arena": "cargo run --release -q -p hf-arena --",
    "change-log": "python ./scripts/change_log_helper/build.py",
    "check": "vue-tsc --noEmit",
    "no-test-build": "pnpm run wasm && vite build",
    "build": "pnpm run test && pnpm run no-test-build && cargo +nightly udeps",
    "no-check-deploy": "git push origin main:Production --force-with-lease",
    "deploy": "pwsh -File ./scripts/pre_deploy_check.ps1 && pnpm run no-check-deploy",
    "cloudflare-deploy": "wrangler deploy --config cloudflare/wrangler.toml",
    "cloudflare-dev": "wrangler dev --remote --config cloudflare/wrangler.toml",
    "pull-analytics": "node scripts/pull-analytics.mjs",
    "analytics": "pnpm run pull-analytics && python -m streamlit run scripts/analytics/app.py",
    "market": "python -m streamlit run scripts/market/app.py",
    "remove-tmp": "node -e \"require('fs').rmSync('.tmp', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dom-webcodecs": "^0.1.19",
    "@vueuse/core": "^14.4.0",
    "brotli-dec-wasm": "^2.3.2",
    "chart.js": "4.5.1",
    "chartjs-plugin-annotation": "3.1.0",
    "fast-deep-equal": "^3.1.3",
    "lz-string": "^1.5.0",
    "marked": "^18.1.1",
    "pinia": "^3.0.4",
    "primevue": "^4.5.5",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/mcp": "^0.0.83",
    "@playwright/test": "^1.64.1",
    "@types/dom-mediacapture-transform": "^0.1.12",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/test-utils": "2.5.1",
    "concurrently": "^10.0.6",
    "devalue": "^6.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "5.0.5",
    "vue-tsc": "^2.2.12",
    "wrangler": "^4.151.1"
  }
}
