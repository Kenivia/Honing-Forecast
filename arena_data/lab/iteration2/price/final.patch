+                        respond_one(&mut kicked, index, probe);
+                    }
+                }
+            }
+            "chest" => {
+                let key = &stacks[rng.random_range(0..stacks.len())];
+                let mut states = kicked.chest_states.clone();
+                states.insert(
+                    key.clone(),
+                    kicked.prep_output.chests[key].random_state(rng),
